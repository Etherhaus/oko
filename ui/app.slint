// The Oko window.
//
// One screen, three bands: the header (who this is, the global switches), the
// run band (the one action, its progress, the summary of the last run), and the
// two panes (the targets, the details of the chosen one). Settings and the
// export live behind the header menu, so the screen holds only what a run
// needs.
//
// Every user-visible string comes from the `Labels` global, which the Rust side
// fills from `src/i18n.rs`. The palette lives in `Theme`; the window frame is
// the coral the Ether family uses.

import { ScrollView } from "std-widgets.slint";

// One row of the target list: a group header or a target.
export struct TargetRow {
    // The row's place in the target list; -1 on a group header.
    index: int,
    // The group a header stands for, so the header's box can tick the whole
    // group and its click can fold it.
    group: int,
    // A header row: the category's name, how many of its targets are ticked,
    // and a box that ticks the group.
    header: bool,
    domain: string,
    checked: bool,
    // The canonical verdict name, empty until the target has been probed.
    verdict: string,
    // 0 ok, 1 warn, 2 bad, 3 undetermined, 4 not probed.
    level: int,
    // The level in the window's language: the report's own words stay English.
    level-text: string,
    // The tunnel comparison, empty until a tunnel run has been made.
    diff: string,
    running: bool,
    // A target the user added: it can be removed, and the list marks it.
    custom: bool,
    // Header only: "ticked/total" of the group.
    count: string,
    // Header only: the group is folded, its targets are not in the model.
    collapsed: bool,
}

export global Labels {
    in property <string> subtitle;
    in property <string> targets;
    in property <string> details;
    in property <string> details-empty;
    in property <string> details-not-probed;
    in property <string> check;
    in property <string> check-all;
    in property <string> check-none;
    in property <string> timeout;
    in property <string> timeout-hint;
    in property <string> socks5;
    in property <string> socks5-hint;
    in property <string> socks5-placeholder;
    in property <string> dark;
    in property <string> light;
    in property <string> export-text;
    in property <string> export-json;
    in property <string> export-title;
    in property <string> not-checked;
    in property <string> in-progress;
    in property <string> level-ok;
    in property <string> level-warn;
    in property <string> level-bad;
    in property <string> level-undetermined;
    in property <string> col-target;
    in property <string> col-verdict;
    in property <string> ready;
    in property <string> checking;
    in property <string> done;
    in property <string> control-dead;
    in property <string> run-failed;
    in property <string> nothing-selected;
    in property <string> bad-socks5;
    in property <string> export-empty;
    in property <string> export-done;
    in property <string> export-failed;

    // The groups of the target list.
    in property <string> category-video-hosting;
    in property <string> category-social;
    in property <string> category-messenger;
    in property <string> category-audio;
    in property <string> category-video;
    in property <string> category-games;
    in property <string> category-encyclopedia;
    in property <string> category-development;
    in property <string> category-custom;
    in property <string> category-news;
    in property <string> category-search;
    in property <string> category-ai;

    // Targets the user adds.
    in property <string> add-domain;
    in property <string> add;
    in property <string> cancel;
    in property <string> domain-placeholder;
    in property <string> remove;
    in property <string> custom-mark;
    in property <string> bad-domain;
    in property <string> duplicate-domain;

    // The window frame.
    in property <string> frame;

    // The dashboard.
    in property <string> dash-ok;
    in property <string> dash-blocked;
    in property <string> dash-unknown;
    in property <string> dash-empty;
    in property <string> dash-delta;
    in property <string> seconds;

    // The watchdog.
    in property <string> interrupted;

    // The menu, the settings dialog and the panes.
    in property <string> menu;
    in property <string> settings;
    in property <string> close;
    in property <string> done-settings;
    in property <string> export;
    in property <string> targets-count;
    in property <string> checked-count;
    in property <string> collapse;
    in property <string> expand;
}

export global Theme {
    out property <string> font-family: "Adwaita Sans";
    out property <string> mono: "JetBrains Mono";

    in-out property <bool> dark: true;

    out property <color> bg: dark ? #16161a : #f6f5f4;
    // The page is lit from above, like the site's --bg-glow.
    out property <brush> bg-glow: dark
        ? @linear-gradient(180deg, #232329 0%, #1b1b1f 45%, #16161a 100%)
        : @linear-gradient(180deg, #ffffff 0%, #f6f5f4 55%, #efeeec 100%);
    out property <color> surface: dark ? #242428 : #ffffff;
    out property <color> surface-2: dark ? #303036 : #f0efed;
    out property <color> surface-3: dark ? #1b1b1f : #faf9f8;
    // Fields sit below the card they are on, in both themes.
    out property <color> field: dark ? #1b1b1f : #f0efed;
    out property <color> line: dark ? #FFFFFF1A : #0000001F;
    out property <color> line-soft: dark ? #FFFFFF12 : #00000014;
    out property <color> text: dark ? #f6f5f4 : #1b1b1f;
    out property <color> text-2: dark ? #FFFFFFE0 : #2b2b31;
    out property <color> dim: dark ? #8b8b93 : #5e5e66;
    out property <color> dim-2: dark ? #FFFFFF8C : #6b6b73;

    // #d9531e on white is 4.03:1, so light-theme text uses accent-ink instead.
    out property <color> accent: dark ? #fb8762 : #d9531e;
    out property <color> accent-ink: dark ? #fb8762 : #b8431a;
    out property <color> on-accent: dark ? #16161a : #ffffff;
    out property <color> accent-soft: dark ? #FB87621F : #D9531E1A;
    out property <color> accent-soft-2: dark ? #FB876242 : #D9531E33;
    out property <color> accent-line: dark ? #FB876273 : #D9531E66;

    // The verdict levels: ok is green, warn and undetermined are yellow, a
    // block is red. The greens are the only hue the Ether palette adds.
    out property <color> ok: dark ? #7fd18b : #2e7d32;
    out property <color> ok-soft: dark ? #7FD18B1F : #2E7D321A;
    out property <color> warn: dark ? #f8e45c : #8a6d00;
    out property <color> warn-soft: dark ? #F8E45C1F : #8A6D001A;
    out property <color> bad: dark ? #f66151 : #b3261e;
    out property <color> bad-soft: dark ? #F661511F : #B3261E1A;

    // The 1px light line along the top edge of a card.
    out property <color> highlight: dark ? #FFFFFF12 : #FFFFFFE6;
    out property <color> shadow: dark ? #0000008C : #0000001F;
    out property <length> shadow-blur: 30px;

    out property <length> radius-win: 24px;
    out property <length> radius-card: 16px;
    out property <length> radius-sm: 10px;

    out property <duration> motion: 140ms;
}

// A solid card: hairline border, a light line along the top edge, and a shadow.
component Card inherits Rectangle {
    in property <length> radius: Theme.radius-card;
    in property <color> fill: Theme.surface;
    in property <color> edge: Theme.line;

    background: root.fill;
    border-radius: root.radius;
    border-width: 1px;
    border-color: root.edge;
    drop-shadow-color: Theme.shadow;
    drop-shadow-blur: Theme.shadow-blur;
    drop-shadow-offset-y: 8px;

    Rectangle {
        x: root.radius;
        y: 1px;
        width: parent.width - root.radius * 2;
        height: 1px;
        background: Theme.highlight;
    }
}

// The small mono label that names a block: "ЦЕЛИ", "ДЕТАЛИ".
component Eyebrow inherits Text {
    color: Theme.dim;
    font-family: Theme.mono;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.9px;
    vertical-alignment: center;
}

// A flat button with a hairline border.
component GhostButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    width: label.preferred-width + 24px;
    border-radius: 9px;
    background: touch.has-hover && root.enabled ? Theme.surface-2 : transparent;
    border-width: 1px;
    border-color: Theme.line;
    opacity: root.enabled ? 1 : 0.45;

    label := Text {
        text: root.text;
        color: Theme.text-2;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A word that acts as a button: "все", "ничего". No border, no fill.
component TextLink inherits Text {
    in property <bool> enabled: true;
    callback clicked();

    color: touch.has-hover && root.enabled ? Theme.accent-ink : Theme.dim;
    font-size: 11px;
    vertical-alignment: center;
    opacity: root.enabled ? 1 : 0.45;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// The one coral button in the window.
component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 38px;
    border-radius: 11px;
    background: touch.pressed && root.enabled ? Theme.accent-ink : Theme.accent;
    opacity: root.enabled ? 1 : 0.45;

    Text {
        text: root.text;
        color: Theme.on-accent;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// One half of a two-option switch.
component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    horizontal-stretch: 1;
    border-radius: 7px;
    background: root.active ? Theme.accent-soft : transparent;
    border-width: 1px;
    border-color: root.active ? Theme.accent-line : transparent;

    Text {
        text: root.text;
        color: root.active ? Theme.accent-ink : Theme.dim;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A two-option switch: the theme and the language both use it.
component Segmented inherits Rectangle {
    in property <string> first;
    in property <string> second;
    in property <bool> second-active;
    callback pick-first();
    callback pick-second();

    height: 30px;
    border-radius: 9px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.line;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        Segment {
            text: root.first;
            active: !root.second-active;
            clicked => {
                root.pick-first();
            }
        }
        Segment {
            text: root.second;
            active: root.second-active;
            clicked => {
                root.pick-second();
            }
        }
    }
}

// One button of the stepper.
component StepButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    width: 28px;
    border-radius: 7px;
    background: touch.has-hover ? Theme.surface-2 : transparent;

    Text {
        text: root.text;
        color: Theme.text-2;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A number with a minus and a plus: the timeout.
component Stepper inherits Rectangle {
    in property <int> value;
    callback dec();
    callback inc();

    height: 30px;
    width: 104px;
    border-radius: 9px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.line;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        StepButton {
            text: "-";
            clicked => {
                root.dec();
            }
        }
        Text {
            text: "\{root.value}";
            color: Theme.text;
            font-family: Theme.mono;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        StepButton {
            text: "+";
            clicked => {
                root.inc();
            }
        }
    }
}

// A text field with a placeholder.
component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    callback edited(string);

    height: 30px;
    border-radius: 9px;
    background: Theme.field;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-line : Theme.line;

    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        edited => {
            root.edited(self.text);
        }
    }

    if input.text == "" && !input.has-focus: Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.dim;
        font-size: 13px;
        vertical-alignment: center;
    }
}

// The checkbox of one row.
component Check inherits Rectangle {
    in property <bool> checked;
    callback toggled();

    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: root.checked ? Theme.accent : transparent;
    border-width: 1.5px;
    border-color: root.checked ? Theme.accent : Theme.dim;

    if root.checked: Path {
        width: 12px;
        height: 12px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 1 6 L 4.5 9.5 L 11 2.5";
        stroke: Theme.on-accent;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

// The change of one counter against the previous run, as a small badge: it
// must not read as part of the label next to it.
component Delta inherits Rectangle {
    in property <string> text;

    height: 15px;
    width: delta-label.preferred-width + 10px;
    border-radius: 5px;
    background: Theme.field;

    delta-label := Text {
        text: root.text;
        color: Theme.dim;
        font-family: Theme.mono;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

// A 24px square button with a glyph: the remove mark of a custom target.
component MiniButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: touch.has-hover ? Theme.surface-2 : transparent;

    Text {
        text: root.text;
        color: touch.has-hover ? Theme.bad : Theme.dim;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The header's menu button: three dots, drawn rather than typed, because the
// UI font has no glyph for them.
component MenuButton inherits Rectangle {
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: touch.has-hover || root.open ? Theme.surface-2 : transparent;
    border-width: 1px;
    border-color: touch.has-hover || root.open ? Theme.line : transparent;

    in property <bool> open: false;

    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;
        spacing: 3px;

        Rectangle {
            width: 3px;
            height: 3px;
            border-radius: 2px;
            background: Theme.text-2;
        }
        Rectangle {
            width: 3px;
            height: 3px;
            border-radius: 2px;
            background: Theme.text-2;
        }
        Rectangle {
            width: 3px;
            height: 3px;
            border-radius: 2px;
            background: Theme.text-2;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One line of the header menu.
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    border-radius: 8px;
    background: touch.has-hover && root.enabled ? Theme.surface-2 : transparent;
    opacity: root.enabled ? 1 : 0.4;

    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        color: Theme.text-2;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// The bar of a dialog: the niri window, title in the middle, close on the right.
component TitleBar inherits Rectangle {
    in property <string> title;
    callback close();

    height: 40px;
    background: Theme.surface-2;

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.line;
    }

    Text {
        x: 44px;
        width: parent.width - 88px;
        height: parent.height;
        text: root.title;
        color: Theme.text;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.2px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: close-touch.has-hover ? Theme.accent : Theme.surface-3;

        Text {
            text: "×";
            color: close-touch.has-hover ? Theme.on-accent : Theme.dim;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }

        close-touch := TouchArea {
            clicked => {
                root.close();
            }
        }
    }
}

// A dimmed overlay with a centered window of its own. Escape cancels it.
component Modal inherits Rectangle {
    in property <string> title;
    callback cancel();

    background: #000000B8;

    TouchArea {
        clicked => {
            root.cancel();
        }
    }

    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            reject
        }

        Rectangle {
            width: min(420px, root.width - 40px);
            height: card.preferred-height;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.surface;
            border-radius: Theme.radius-win;
            border-width: 3px;
            border-color: Theme.accent;
            drop-shadow-color: #00000099;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 18px;
            clip: true;

            card := VerticalLayout {
                TitleBar {
                    title: root.title;
                    close => {
                        root.cancel();
                    }
                }

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    @children
                }
            }
        }
    }
}

// One row of the target list: a group header or a target.
component TargetItem inherits Rectangle {
    in property <TargetRow> item;
    in property <bool> selected;
    callback toggle();
    callback select();
    callback remove();
    callback collapse();

    height: root.item.header ? 28px : 46px;
    border-radius: Theme.radius-sm;
    background: root.item.header ? transparent : (root.selected ? Theme.accent-soft : (touch.has-hover ? Theme.surface-2 : transparent));

    // The row's own hit area sits below the content, so the checkbox and the
    // remove button get their clicks first.
    touch := TouchArea {
        clicked => {
            if root.item.header {
                root.collapse();
            } else {
                root.select();
            }
        }
    }

    if root.item.header: HorizontalLayout {
        padding-left: 2px;
        padding-right: 6px;
        spacing: 8px;
        // `alignment` is the main axis (horizontal here); the cross axis is
        // what centres the box and the label vertically.
        cross-axis-alignment: center;

        Text {
            text: root.item.collapsed ? "▸" : "▾";
            color: Theme.dim;
            font-size: 9px;
            width: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            text: root.item.domain;
            color: Theme.dim;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.item.count;
            color: Theme.dim;
            font-family: Theme.mono;
            font-size: 10px;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Check {
            checked: root.item.checked;
            vertical-stretch: 0;
            toggled => {
                root.toggle();
            }
        }
    }

    if !root.item.header: HorizontalLayout {
        padding-left: 2px;
        padding-right: 6px;
        spacing: 10px;
        cross-axis-alignment: center;

        Check {
            checked: root.item.checked;
            vertical-stretch: 0;
            toggled => {
                root.toggle();
            }
        }

        VerticalLayout {
            spacing: 1px;
            vertical-stretch: 1;
            alignment: center;

            Text {
                text: root.item.domain;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.item.running ? Labels.in-progress : (root.item.verdict == "" ? Labels.not-checked : root.item.level-text);
                color: root.item.running ? Theme.accent-ink : (root.item.verdict == "" ? Theme.dim : (root.item.level == 0 ? Theme.ok : (root.item.level == 2 ? Theme.bad : Theme.warn)));
                font-size: 10px;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        // The technical name of the verdict: the human word is on the left.
        Text {
            text: root.item.verdict;
            color: Theme.dim;
            font-family: Theme.mono;
            font-size: 10px;
            width: 92px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.item.custom: MiniButton {
            text: "×";
            clicked => {
                root.remove();
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Oko";
    // Small enough for a 1280x720 screen; a tiling window manager gives the
    // window the whole screen anyway.
    preferred-width: 900px;
    preferred-height: 620px;
    min-width: 780px;
    min-height: 520px;
    default-font-size: 14px;
    default-font-family: Theme.font-family;
    // The frame is the window background; the surface sits inside it.
    background: Theme.accent;
    property <length> frame-width: root.frame ? 3px : 0px;

    in-out property <[TargetRow]> rows;
    in-out property <int> selected: -1;
    in-out property <bool> running: false;
    in-out property <float> progress: 0;
    in-out property <string> status;
    in-out property <string> detail;
    in-out property <string> detail-title;
    in-out property <string> detail-mark;
    in-out property <string> export-status;
    in-out property <bool> export-enabled: false;
    in-out property <int> timeout-value: 5;
    in-out property <string> socks5-text;
    in-out property <string> lang: "en";
    in-out property <bool> frame: true;
    in-out property <bool> adding: false;
    in-out property <string> add-text;
    in-out property <bool> settings-open: false;
    in-out property <bool> menu-open: false;
    in-out property <string> targets-count;
    in-out property <string> checked-count;
    in-out property <string> dash-ok: "0";
    in-out property <string> dash-blocked: "0";
    in-out property <string> dash-unknown: "0";
    in-out property <string> dash-ok-delta;
    in-out property <string> dash-blocked-delta;
    in-out property <string> dash-unknown-delta;
    in-out property <string> dash-info;
    in-out property <string> dash-delta;
    in-out property <bool> dash-empty: true;

    callback toggle(int);
    callback toggle-group(int);
    callback toggle-collapse(int);
    callback select(int);
    callback remove(int);
    callback check-all();
    callback check-none();
    callback start();
    callback timeout-dec();
    callback timeout-inc();
    callback export-text();
    callback export-json();
    callback pick-dark();
    callback pick-light();
    callback pick-ru();
    callback pick-en();
    callback socks5-edited(string);
    callback toggle-frame();
    callback begin-add();
    callback cancel-add();
    callback add-text-edited(string);
    callback add-domain();
    callback open-settings();
    callback close-settings();
    callback toggle-menu();
    callback close-menu();

    Rectangle {
        x: root.frame-width;
        y: root.frame-width;
        width: parent.width - 2 * root.frame-width;
        height: parent.height - 2 * root.frame-width;
        border-radius: root.frame ? Theme.radius-win : 0px;
        background: Theme.bg-glow;
        clip: true;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // The header: who this is, and the switches that are not about a
            // run.
            HorizontalLayout {
                height: 44px;
                spacing: 10px;
                cross-axis-alignment: center;

                VerticalLayout {
                    spacing: 1px;
                    vertical-stretch: 0;

                    Text {
                        text: "Oko";
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 700;
                    }
                    Text {
                        text: Labels.subtitle;
                        color: Theme.dim;
                        font-size: 11px;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Segmented {
                    width: 132px;
                    first: Labels.dark;
                    second: Labels.light;
                    second-active: !Theme.dark;
                    pick-first => {
                        root.pick-dark();
                    }
                    pick-second => {
                        root.pick-light();
                    }
                }
                Segmented {
                    width: 76px;
                    first: "RU";
                    second: "EN";
                    second-active: root.lang == "en";
                    pick-first => {
                        root.pick-ru();
                    }
                    pick-second => {
                        root.pick-en();
                    }
                }
                MenuButton {
                    open: root.menu-open;
                    clicked => {
                        root.toggle-menu();
                    }
                }
            }

            // The run band: the one action, its progress, and the summary of
            // the last run under it.
            Card {
                height: 62px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 12px;
                        cross-axis-alignment: center;

                        PrimaryButton {
                            text: Labels.check;
                            width: 150px;
                            enabled: !root.running;
                            clicked => {
                                root.start();
                            }
                        }

                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.field;
                            border-width: 1px;
                            border-color: Theme.line;
                            horizontal-stretch: 1;
                            vertical-stretch: 0;

                            // Accent only while the run is live: a full accent
                            // bar at rest reads as "still working".
                            Rectangle {
                                width: parent.width * root.progress;
                                height: parent.height;
                                border-radius: 3px;
                                background: root.running ? Theme.accent : Theme.line;
                                animate width { duration: Theme.motion; }
                                animate background { duration: Theme.motion; }
                            }
                        }

                        Text {
                            text: root.status;
                            color: Theme.dim;
                            font-size: 11px;
                            vertical-alignment: center;
                            width: 190px;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }
                }
            }

            // The dashboard: the counters of the last run, the delta to the one
            // before it, and when it happened.
            HorizontalLayout {
                height: 20px;
                spacing: 18px;
                cross-axis-alignment: center;

                if root.dash-empty: Text {
                    text: Labels.dash-empty;
                    color: Theme.dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                if !root.dash-empty: HorizontalLayout {
                    spacing: 6px;
                    cross-axis-alignment: end;

                    Text {
                        text: root.dash-ok;
                        color: Theme.ok;
                        font-family: Theme.mono;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    Text {
                        text: Labels.dash-ok;
                        color: Theme.dim;
                        font-size: 11px;
                    }
                    if root.dash-ok-delta != "": Delta {
                        text: root.dash-ok-delta;
                    }
                }
                if !root.dash-empty: HorizontalLayout {
                    spacing: 6px;
                    cross-axis-alignment: end;

                    Text {
                        text: root.dash-blocked;
                        color: Theme.bad;
                        font-family: Theme.mono;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    Text {
                        text: Labels.dash-blocked;
                        color: Theme.dim;
                        font-size: 11px;
                    }
                    if root.dash-blocked-delta != "": Delta {
                        text: root.dash-blocked-delta;
                    }
                }
                if !root.dash-empty: HorizontalLayout {
                    spacing: 6px;
                    cross-axis-alignment: end;

                    Text {
                        text: root.dash-unknown;
                        color: Theme.warn;
                        font-family: Theme.mono;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    Text {
                        text: Labels.dash-unknown;
                        color: Theme.dim;
                        font-size: 11px;
                    }
                    if root.dash-unknown-delta != "": Delta {
                        text: root.dash-unknown-delta;
                    }
                }

                if root.dash-delta != "": Text {
                    text: root.dash-delta;
                    color: Theme.dim;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.dash-info;
                    color: Theme.dim;
                    font-family: Theme.mono;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            // The two panes: what to check on the left, what came back on the
            // right.
            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;

                Card {
                    horizontal-stretch: 42;
                    min-height: 0px;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Eyebrow {
                                text: Labels.targets;
                            }
                            Text {
                                text: root.targets-count;
                                color: Theme.dim;
                                font-family: Theme.mono;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            TextLink {
                                text: Labels.check-all;
                                clicked => {
                                    root.check-all();
                                }
                            }
                            TextLink {
                                text: Labels.check-none;
                                clicked => {
                                    root.check-none();
                                }
                            }
                            GhostButton {
                                text: Labels.add-domain;
                                clicked => {
                                    root.begin-add();
                                }
                            }
                        }

                        if root.adding: HorizontalLayout {
                            spacing: 6px;
                            cross-axis-alignment: center;

                            Field {
                                text: root.add-text;
                                placeholder: Labels.domain-placeholder;
                                horizontal-stretch: 1;
                                edited(text) => {
                                    root.add-text-edited(text);
                                }
                            }
                            GhostButton {
                                text: Labels.add;
                                clicked => {
                                    root.add-domain();
                                }
                            }
                            GhostButton {
                                text: Labels.cancel;
                                clicked => {
                                    root.cancel-add();
                                }
                            }
                        }

                        // The list scrolls inside the card: without the zero
                        // minimum the window would grow to fit every row.
                        ScrollView {
                            vertical-stretch: 1;
                            min-height: 0px;

                            VerticalLayout {
                                spacing: 1px;

                                for entry in root.rows: TargetItem {
                                    item: entry;
                                    selected: root.selected == entry.index;
                                    toggle => {
                                        if entry.header {
                                            root.toggle-group(entry.group);
                                        } else {
                                            root.toggle(entry.index);
                                        }
                                    }
                                    collapse => {
                                        root.toggle-collapse(entry.group);
                                    }
                                    select => {
                                        root.select(entry.index);
                                    }
                                    remove => {
                                        root.remove(entry.index);
                                    }
                                }
                            }
                        }
                    }
                }

                Card {
                    horizontal-stretch: 58;
                    min-height: 0px;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Eyebrow {
                                text: Labels.details;
                            }
                            Text {
                                text: root.detail-title;
                                color: Theme.accent-ink;
                                font-family: Theme.mono;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: root.detail-mark;
                                color: Theme.dim;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }

                        if root.detail == "": Text {
                            text: root.selected >= 0 ? Labels.details-not-probed : Labels.details-empty;
                            color: Theme.dim;
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-stretch: 1;
                        }

                        // The report is the CLI's text, so it wraps rather than
                        // scrolls sideways: a long line is still readable, and
                        // the columns only break where the panel is too narrow.
                        if root.detail != "": Flickable {
                            content-width: self.width;
                            content-height: detail-text.preferred-height;
                            vertical-stretch: 1;
                            min-height: 0px;

                            detail-text := Text {
                                width: parent.width;
                                text: root.detail;
                                color: Theme.text-2;
                                font-family: Theme.mono;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // The header menu: settings and the two exports. It closes on a click
        // anywhere else.
        if root.menu-open: Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            TouchArea {
                clicked => {
                    root.close-menu();
                }
            }
        }

        if root.menu-open: Rectangle {
            x: parent.width - self.width - 16px;
            y: 64px;
            width: 216px;
            height: menu-layout.preferred-height;
            background: Theme.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 10px;

            menu-layout := VerticalLayout {
                padding: 6px;
                spacing: 2px;

                MenuItem {
                    text: Labels.settings;
                    clicked => {
                        root.open-settings();
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }

                MenuItem {
                    text: Labels.export-text;
                    enabled: root.export-enabled;
                    clicked => {
                        root.export-text();
                    }
                }
                MenuItem {
                    text: Labels.export-json;
                    enabled: root.export-enabled;
                    clicked => {
                        root.export-json();
                    }
                }

                if root.export-status != "": VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 4px;
                    padding-bottom: 4px;

                    Text {
                        text: root.export-status;
                        color: Theme.dim;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // The settings dialog: the three things that change how a run behaves.
        if root.settings-open: Modal {
            title: Labels.settings;
            cancel => {
                root.close-settings();
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: Labels.timeout;
                    color: Theme.text-2;
                    font-size: 12px;
                }
                Stepper {
                    value: root.timeout-value;
                    dec => {
                        root.timeout-dec();
                    }
                    inc => {
                        root.timeout-inc();
                    }
                }
                Text {
                    text: Labels.timeout-hint;
                    color: Theme.dim;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: Labels.socks5;
                    color: Theme.text-2;
                    font-size: 12px;
                }
                Field {
                    text: root.socks5-text;
                    placeholder: Labels.socks5-placeholder;
                    edited(text) => {
                        root.socks5-edited(text);
                    }
                }
                Text {
                    text: Labels.socks5-hint;
                    color: Theme.dim;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;

                Check {
                    checked: root.frame;
                    vertical-stretch: 0;
                    toggled => {
                        root.toggle-frame();
                    }
                }
                Text {
                    text: Labels.frame;
                    color: Theme.text-2;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            PrimaryButton {
                text: Labels.done-settings;
                clicked => {
                    root.close-settings();
                }
            }
        }
    }
}
